# Supabase (emr-ai-clinic project)
# Used for ACLS knowledge content (acls_* tables) and admin auth.
VITE_SUPABASE_URL=https://elyyijlcjfvhxbpzscnv.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ie9hrnsxONcotMSqcQF_Og_zXj-8sIp

# --- ฝั่ง server (serverless functions ใน api/) เท่านั้น — ไม่มี VITE_ prefix ---
# ต้องตั้งค่า "แยกทุก deployment" (acls-emr, bls-morroo, ...) ไม่ได้ share กันเอง
#
# Service role key ของ Supabase project เดียวกับด้านบน — ใช้ตรวจสิทธิ์แอดมิน
# (api/_lib/requireAdmin.js) ถ้าไม่ตั้ง ทุก endpoint ใต้ api/admin, api/video-lessons,
# api/code-blue, api/recorder-cases ฯลฯ จะตอบ 503 "ยังไม่ได้ตั้งค่า"
# ห้ามใส่ VITE_ prefix เด็ดขาด — key นี้ข้าม RLS ทั้งหมด ถ้าหลุดไป client คือเจ๊ง
SUPABASE_URL=https://elyyijlcjfvhxbpzscnv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — ใช้กับปุ่ม "ร่างสรุปด้วย AI" / "สร้างควิซด้วย AI" และ
# endpoint ที่เรียก Claude อื่น ๆ ถ้าไม่ตั้ง จะตอบ 500 "API key not configured"
ANTHROPIC_API_KEY=

# รายชื่ออีเมลแอดมิน (คั่นด้วย comma) — ไม่ตั้งก็ได้ จะใช้ default ใน requireAdmin.js
# ต้องตรงกับ RLS policy ฝั่ง Supabase ด้วย
ADMIN_EMAILS=

# Meta (Facebook) Pixel — สำหรับวัดผล/optimize โฆษณา (ดูได้ใน Events Manager)
# ทิ้งว่างไว้ได้ในเครื่อง dev — Pixel จะไม่ทำงานถ้าไม่ตั้งค่า
VITE_META_PIXEL_ID=

# PostHog (us cloud) — dashboard/funnel วัด conversion จากโฆษณา
# ทิ้งว่างไว้ได้ในเครื่อง dev — PostHog จะไม่โหลดถ้าไม่ตั้งค่า
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# LINE Official Account (Messaging API) — แจ้งเตือน admin เมื่อมีนักเรียนได้ใบประกาศนียบัตร
# ตั้งค่าเฉพาะฝั่ง server เท่านั้น (ไม่มี VITE_ prefix → ไม่หลุดไป client)
# ถ้าไม่ตั้งค่า endpoint /api/cert/notify จะ skip เงียบ ๆ (ใบยังออกได้ปกติ)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=

# บัญชี JIA กลาง (Hub, class.jiacpr.com) — "เข้าสู่ระบบด้วยบัญชี JIA" แบบไม่บังคับ
# ดู docs/hub-passport.md — ตั้งค่าแยกทุก deployment (acls/airway/defib/iv/bls มี client ของตัวเอง)
# ถ้าไม่ตั้ง 2 ตัวแรก ปุ่มจะไม่แสดงเลย (/api/passport/me ตอบ configured:false)
# ฝั่ง server เท่านั้น — ห้ามใส่ VITE_ prefix (secret หลุดไป client = ใครก็แลก code ในนามแอปนี้ได้)
HUB_PASSPORT_CLIENT_ID=
HUB_PASSPORT_CLIENT_SECRET=
# (ไม่บังคับ) ปักหมุด redirect URI — ปกติคำนวณจากโดเมนที่เข้ามาเป็น https://<โดเมน>/api/passport/callback
HUB_PASSPORT_REDIRECT_URI=
